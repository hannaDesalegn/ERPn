{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness. `strict` is non-negotiable in a domain-modelling codebase:
       the types are the specification, and nullable holes make them lie. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Path alias — must mirror the alias in vite.config.ts.
       No baseUrl: paths are resolved relative to this tsconfig, which is the
       modern behaviour (baseUrl is deprecated as of TypeScript 6). */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}

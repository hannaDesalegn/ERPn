{
  "name": "erp",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @erp/web",
    "dev:web": "npm run dev --workspace @erp/web",
    "dev:api": "npm run dev --workspace @erp/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}

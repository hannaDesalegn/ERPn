# Copy to .env for local development. Never commit a real .env.
# Production values come from the secret store, never from a file in the repository.
NODE_ENV=development
PORT=3000
# Loopback by default. A container must set HOST=0.0.0.0 to be reachable.
HOST=127.0.0.1
LOG_LEVEL=debug

# Connection string for the RESTRICTED application role, never the owner.
# Matches the defaults in docker-compose.yml at the repository root.
DATABASE_URL=postgresql://erp_app:erp_app_local_dev@127.0.0.1:5432/erp_dev
DATABASE_POOL_MAX=10

# Connection string for the OWNING role. Used only by the migration runner, never by the
# API process, so that a misconfigured API cannot issue DDL. Contract section 7.1.
MIGRATION_DATABASE_URL=postgresql://erp_migrator:erp_migrator_local_dev@127.0.0.1:5432/erp_dev
# Role name that migrations grant to, exposed to SQL as app.provision_role.
APP_DB_ROLE=erp_app

# Copy to .env for local development. Never commit a real .env.
# Production values come from the secret store, never from a file in the repository.
NODE_ENV=development
PORT=3000
# Loopback by default. A container must set HOST=0.0.0.0 to be reachable.
HOST=127.0.0.1
LOG_LEVEL=debug

# Connection string for the RESTRICTED application role, never the owner.
# Matches the defaults in docker-compose.yml at the repository root.
DATABASE_URL=postgresql://erp_app:erp_app_local_dev@127.0.0.1:5432/erp_dev
DATABASE_POOL_MAX=10

# Connection string for the OWNING role. Used only by the migration runner, never by the
# API process, so that a misconfigured API cannot issue DDL. Contract section 7.1.
MIGRATION_DATABASE_URL=postgresql://erp_migrator:erp_migrator_local_dev@127.0.0.1:5432/erp_dev
# Role name that migrations grant to, exposed to SQL as app.provision_role.
APP_DB_ROLE=erp_app

# Authentication policy. Contract section 5.3: deployment level, not per company, because
# authentication happens before any company is known. All of these have safe defaults; set
# one only to override it.
#
# Argon2id cost. Raise memory first when revisiting: it is the parameter an attacker cannot
# trade away. Existing hashes keep working, because each records the cost it was made with.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Session lifetime. Idle is extended by use, absolute never is.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_MINUTES=720

# Login throttling, per address and per account.
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15

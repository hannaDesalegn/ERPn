# Local development overrides for docker-compose.yml.
#
# Copy to .env only if you need to change a default. Compose works without it.
#   cp .env.example .env
#
# These are local development values. They are not secrets, they never leave your machine,
# and they have no production counterpart. Production credentials come from a managed secret
# store and are injected at runtime, per architecture contract sections 14.8 and 15.5.
#
# The API does not read this file. Its own settings live in apps/api/.env.example.

POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_local_dev
POSTGRES_DB=erp_dev

# The restricted role the API connects as. It owns nothing and has no DDL rights.
APP_DB_USER=erp_app
APP_DB_PASSWORD=erp_app_local_dev

# Host port the database is published on, bound to 127.0.0.1 only.
# Change this if 5432 is already taken by another PostgreSQL on your machine.
POSTGRES_PORT=5432
